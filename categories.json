{
  "categories": [
    {
      "id": "temp",
      "name": { "pt-BR": "Arquivos temporários", "en": "Temporary files" },
      "description": { "pt-BR": "Arquivos que os programas deixaram na pasta temporária, com mais de um dia.", "en": "Files that programs left in the temporary folder, older than one day." },
      "group": "system",
      "targets": [
        { "path": "%TEMP%", "mode": "contents", "ageHours": 24, "exclude": ["claude"] }
      ]
    },
    {
      "id": "claude-sessions",
      "name": { "pt-BR": "Sessões encerradas do Claude", "en": "Finished Claude sessions" },
      "description": { "pt-BR": "Pastas temporárias de conversas do Claude Code que já terminaram.", "en": "Temporary folders of Claude Code conversations that have ended." },
      "group": "system",
      "targets": [
        { "path": "%TEMP%\\claude", "mode": "inactiveFolders", "depth": 2, "ageHours": 24 }
      ]
    },
    {
      "id": "windows-temp",
      "name": { "pt-BR": "Temporários do Windows", "en": "Windows temporary files" },
      "description": { "pt-BR": "Arquivos temporários do próprio sistema, com mais de um dia.", "en": "Temporary files of the system itself, older than one day." },
      "group": "system",
      "targets": [
        { "path": "%WINDIR%\\Temp", "mode": "contents", "ageHours": 24, "admin": true },
        { "path": "%WINDIR%\\SystemTemp", "mode": "contents", "ageHours": 24, "admin": true }
      ]
    },
    {
      "id": "windows-update",
      "name": { "pt-BR": "Downloads do Windows Update", "en": "Windows Update downloads" },
      "description": { "pt-BR": "Atualizações que já foram baixadas e instaladas.", "en": "Updates that were already downloaded and installed." },
      "group": "system",
      "targets": [
        { "path": "%WINDIR%\\SoftwareDistribution\\Download", "mode": "windowsUpdate", "admin": true }
      ]
    },
    {
      "id": "delivery-optimization",
      "name": { "pt-BR": "Otimização de Entrega", "en": "Delivery Optimization" },
      "description": { "pt-BR": "Partes de atualizações que o Windows guarda para compartilhar com outros computadores.", "en": "Pieces of updates that Windows keeps to share with other computers." },
      "group": "system",
      "targets": [
        { "path": "%WINDIR%\\ServiceProfiles\\NetworkService\\AppData\\Local\\Microsoft\\Windows\\DeliveryOptimization\\Cache", "mode": "deliveryOptimization", "admin": true }
      ]
    },
    {
      "id": "crash-dumps",
      "name": { "pt-BR": "Despejos de travamento", "en": "Crash dumps" },
      "description": { "pt-BR": "Cópias de memória e relatórios de falhas antigas. Só servem para investigar travamentos.", "en": "Memory copies and reports of past crashes. They are only useful to investigate crashes." },
      "group": "system",
      "targets": [
        { "path": "%LOCALAPPDATA%\\CrashDumps", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\Microsoft\\Windows\\WER", "mode": "contents" },
        { "path": "%WINDIR%\\MEMORY.DMP", "mode": "file", "admin": true },
        { "path": "%WINDIR%\\LiveKernelReports", "mode": "contents", "admin": true },
        { "path": "%WINDIR%\\Minidump", "mode": "contents", "admin": true },
        { "path": "%PROGRAMDATA%\\Microsoft\\Windows\\WER\\ReportArchive", "mode": "contents", "admin": true },
        { "path": "%PROGRAMDATA%\\Microsoft\\Windows\\WER\\ReportQueue", "mode": "contents", "admin": true }
      ]
    },
    {
      "id": "component-store",
      "name": { "pt-BR": "Componentes antigos do Windows", "en": "Old Windows components" },
      "description": { "pt-BR": "Versões substituídas de componentes do sistema. Pode levar até 15 minutos.", "en": "Replaced versions of system components. It can take up to 15 minutes." },
      "group": "system",
      "selectedByDefault": false,
      "slow": true,
      "targets": [
        { "path": "", "mode": "componentStore", "admin": true }
      ]
    },
    {
      "id": "vscode",
      "name": { "pt-BR": "Visual Studio Code", "en": "Visual Studio Code" },
      "description": { "pt-BR": "Extensões desatualizadas, pacotes de instalação, relatórios de falha e logs antigos.", "en": "Outdated extensions, installation packages, crash reports and old logs." },
      "group": "programs",
      "targets": [
        { "path": "%USERPROFILE%\\.vscode\\extensions", "mode": "staleVsCodeExtensions" },
        { "path": "%APPDATA%\\Code\\CachedExtensionVSIXs", "mode": "contents" },
        { "path": "%APPDATA%\\Code\\Crashpad", "mode": "contents" },
        { "path": "%APPDATA%\\Code\\logs", "mode": "contents", "ageHours": 24 },
        { "path": "%APPDATA%\\Code\\CachedData", "mode": "allButNewest" }
      ]
    },
    {
      "id": "chrome",
      "name": { "pt-BR": "Google Chrome", "en": "Google Chrome" },
      "description": { "pt-BR": "Cache de sites e de componentes. Não desconecta de nenhuma conta.", "en": "Website and component cache. It does not sign you out of any account." },
      "group": "programs",
      "blockedBy": [{ "process": "chrome", "name": "Google Chrome" }],
      "targets": [
        { "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Cache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Code Cache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\GPUCache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\DawnGraphiteCache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\DawnWebGPUCache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Service Worker\\CacheStorage", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\ShaderCache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\GrShaderCache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\GraphiteDawnCache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\component_crx_cache", "mode": "contents" }
      ]
    },
    {
      "id": "edge",
      "name": { "pt-BR": "Microsoft Edge", "en": "Microsoft Edge" },
      "description": { "pt-BR": "Cache de sites e de componentes. Não desconecta de nenhuma conta.", "en": "Website and component cache. It does not sign you out of any account." },
      "group": "programs",
      "blockedBy": [{ "process": "msedge", "name": "Microsoft Edge" }],
      "targets": [
        { "path": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Cache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Code Cache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\GPUCache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Service Worker\\CacheStorage", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\ShaderCache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\GrShaderCache", "mode": "contents" }
      ]
    },
    {
      "id": "brave",
      "name": { "pt-BR": "Brave", "en": "Brave" },
      "description": { "pt-BR": "Cache de sites e de componentes. Não desconecta de nenhuma conta.", "en": "Website and component cache. It does not sign you out of any account." },
      "group": "programs",
      "blockedBy": [{ "process": "brave", "name": "Brave" }],
      "targets": [
        { "path": "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\*\\Cache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\*\\Code Cache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\*\\GPUCache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\*\\Service Worker\\CacheStorage", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\ShaderCache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\GrShaderCache", "mode": "contents" }
      ]
    },
    {
      "id": "firefox",
      "name": { "pt-BR": "Mozilla Firefox", "en": "Mozilla Firefox" },
      "description": { "pt-BR": "Cache de sites. Não desconecta de nenhuma conta.", "en": "Website cache. It does not sign you out of any account." },
      "group": "programs",
      "blockedBy": [{ "process": "firefox", "name": "Mozilla Firefox" }],
      "targets": [
        { "path": "%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles\\*\\cache2", "mode": "contents" }
      ]
    },
    {
      "id": "steam",
      "name": { "pt-BR": "Steam", "en": "Steam" },
      "description": { "pt-BR": "Cache da loja, logs e relatórios de falha.", "en": "Store cache, logs and crash reports." },
      "group": "programs",
      "blockedBy": [{ "process": "steam", "name": "Steam" }],
      "targets": [
        { "path": "%LOCALAPPDATA%\\Steam\\htmlcache", "mode": "contents" },
        { "path": "%STEAM%\\logs", "mode": "contents" },
        { "path": "%STEAM%\\dumps", "mode": "contents" },
        { "path": "%STEAM%\\appcache\\httpcache", "mode": "contents" }
      ]
    },
    {
      "id": "launchers",
      "name": { "pt-BR": "Epic, Ubisoft, EA e Riot", "en": "Epic, Ubisoft, EA and Riot" },
      "description": { "pt-BR": "Cache e logs dos launchers de jogos.", "en": "Cache and logs of the game launchers." },
      "group": "programs",
      "blockedBy": [
        { "process": "EpicGamesLauncher", "name": "Epic Games" },
        { "process": "upc", "name": "Ubisoft Connect" },
        { "process": "EADesktop", "name": "EA app" },
        { "process": "RiotClientServices", "name": "Riot Client" }
      ],
      "targets": [
        { "path": "%LOCALAPPDATA%\\EpicGamesLauncher\\Saved\\webcache*", "mode": "folder" },
        { "path": "%LOCALAPPDATA%\\EpicGamesLauncher\\Saved\\Logs", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\Ubisoft Game Launcher\\cache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\Electronic Arts\\EA Desktop\\Logs", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\Riot Games\\Riot Client\\Logs", "mode": "contents" }
      ]
    },
    {
      "id": "discord",
      "name": { "pt-BR": "Discord", "en": "Discord" },
      "description": { "pt-BR": "Cache do app e instaladores de versões antigas.", "en": "App cache and installers of old versions." },
      "group": "programs",
      "blockedBy": [{ "process": "Discord", "name": "Discord" }],
      "targets": [
        { "path": "%LOCALAPPDATA%\\Discord\\packages", "mode": "allButNewest", "pattern": "*.nupkg" },
        { "path": "%APPDATA%\\discord\\Cache", "mode": "contents" },
        { "path": "%APPDATA%\\discord\\Code Cache", "mode": "contents" },
        { "path": "%APPDATA%\\discord\\GPUCache", "mode": "contents" }
      ]
    },
    {
      "id": "dev-caches",
      "name": { "pt-BR": "Caches de desenvolvimento", "en": "Developer caches" },
      "description": { "pt-BR": "Pacotes baixados por npm, pip e Yarn. Eles são baixados de novo quando um projeto precisar.", "en": "Packages downloaded by npm, pip and Yarn. They are downloaded again when a project needs them." },
      "group": "programs",
      "selectedByDefault": false,
      "targets": [
        { "path": "%LOCALAPPDATA%\\npm-cache\\_cacache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\npm-cache\\_logs", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\pip\\cache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\Yarn\\Cache", "mode": "contents" }
      ]
    },
    {
      "id": "ghub",
      "name": { "pt-BR": "Logitech G HUB", "en": "Logitech G HUB" },
      "description": { "pt-BR": "Cache de downloads de atualizações.", "en": "Cache of update downloads." },
      "group": "programs",
      "blockedBy": [{ "process": "lghub", "name": "Logitech G HUB" }],
      "targets": [
        { "path": "%PROGRAMDATA%\\LGHUB\\cache", "mode": "contents", "admin": true }
      ]
    },
    {
      "id": "amd-installers",
      "name": { "pt-BR": "Instaladores de driver da AMD", "en": "AMD driver installers" },
      "description": { "pt-BR": "Arquivos extraídos durante a instalação de drivers de vídeo.", "en": "Files extracted while installing graphics drivers." },
      "group": "programs",
      "targets": [
        { "path": "%SYSTEMDRIVE%\\AMD", "mode": "contents", "admin": true }
      ]
    },
    {
      "id": "program-leftovers",
      "name": { "pt-BR": "Restos de programas desinstalados", "en": "Leftovers of uninstalled programs" },
      "description": { "pt-BR": "Pastas que sobraram depois de desinstalar programas.", "en": "Folders left behind after uninstalling programs." },
      "group": "leftovers",
      "targets": [
        { "path": "%PROGRAMFILES%\\Warp", "mode": "folder", "notInstalled": ["Warp"], "admin": true },
        { "path": "%LOCALAPPDATA%\\Programs\\Opera GX", "mode": "folder", "notInstalled": ["Opera"] },
        { "path": "%LOCALAPPDATA%\\Programs\\Opera", "mode": "folder", "notInstalled": ["Opera"] },
        { "path": "%LOCALAPPDATA%\\moises-desktop-updater", "mode": "folder", "notInstalled": ["Moises"] },
        { "path": "%LOCALAPPDATA%\\Programs\\moises-desktop", "mode": "folder", "notInstalled": ["Moises"] },
        { "path": "%APPDATA%\\Wallpaper Engine", "mode": "folder", "notInstalled": ["Wallpaper Engine"] },
        { "path": "%PROGRAMDATA%\\Piriform", "mode": "folder", "notInstalled": ["CCleaner"], "admin": true },
        { "path": "%PROGRAMFILES%\\Piriform", "mode": "folder", "notInstalled": ["CCleaner"], "admin": true }
      ]
    },
    {
      "id": "recycle-bin",
      "name": { "pt-BR": "Lixeira", "en": "Recycle Bin" },
      "description": { "pt-BR": "Arquivos que você apagou e ainda estão na Lixeira. Depois de esvaziada, não dá para recuperá-los.", "en": "Files you deleted that are still in the Recycle Bin. Once it is emptied, they cannot be recovered." },
      "group": "caution",
      "selectedByDefault": false,
      "targets": [
        { "path": "", "mode": "recycleBin" }
      ]
    },
    {
      "id": "chrome-ai-model",
      "name": { "pt-BR": "Modelo de IA do Chrome", "en": "Chrome AI model" },
      "description": { "pt-BR": "Modelo que o Chrome usa em recursos de IA locais. Ele é baixado de novo se algum recurso precisar.", "en": "Model that Chrome uses for on-device AI features. It is downloaded again if a feature needs it." },
      "group": "caution",
      "selectedByDefault": false,
      "blockedBy": [{ "process": "chrome", "name": "Google Chrome" }],
      "targets": [
        { "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\OptGuideOnDeviceModel", "mode": "folder" }
      ]
    },
    {
      "id": "amd-shaders",
      "name": { "pt-BR": "Cache de shaders da AMD", "en": "AMD shader cache" },
      "description": { "pt-BR": "Os jogos recompilam os shaders depois e podem travar nas primeiras partidas.", "en": "Games compile the shaders again and may stutter in the first matches." },
      "group": "caution",
      "selectedByDefault": false,
      "targets": [
        { "path": "%LOCALAPPDATA%\\AMD\\DxCache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\AMD\\DxcCache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\AMD\\VkCache", "mode": "contents" },
        { "path": "%LOCALAPPDATA%\\AMD\\GLCache", "mode": "contents" }
      ]
    },
    {
      "id": "directx-shaders",
      "name": { "pt-BR": "Cache de shaders do DirectX", "en": "DirectX shader cache" },
      "description": { "pt-BR": "Shaders que o Windows guarda para os jogos. Eles são recompilados depois e os jogos podem travar nas primeiras partidas.", "en": "Shaders Windows keeps for games. They are compiled again and games may stutter in the first matches." },
      "group": "caution",
      "selectedByDefault": false,
      "targets": [
        { "path": "%LOCALAPPDATA%\\D3DSCache", "mode": "contents" }
      ]
    },
    {
      "id": "steam-leftovers",
      "name": { "pt-BR": "Pastas de jogos desinstalados", "en": "Folders of uninstalled games" },
      "description": { "pt-BR": "Pastas na biblioteca da Steam sem jogo instalado. Podem guardar replays, mods ou projetos seus.", "en": "Folders in the Steam library without an installed game. They may hold your replays, mods or projects." },
      "group": "caution",
      "selectedByDefault": false,
      "blockedBy": [{ "process": "steam", "name": "Steam" }],
      "targets": [
        { "path": "", "mode": "steamLeftovers" }
      ]
    },
    {
      "id": "uninstalled-app-data",
      "name": { "pt-BR": "Dados de programas desinstalados", "en": "Data of uninstalled programs" },
      "description": { "pt-BR": "Perfis de navegadores e dados de apps removidos. Podem ter favoritos ou senhas salvas.", "en": "Browser profiles and data of removed apps. They may hold bookmarks or saved passwords." },
      "group": "caution",
      "selectedByDefault": false,
      "targets": [
        { "path": "%APPDATA%\\Mozilla\\Firefox", "mode": "folder", "notInstalled": ["Firefox"] },
        { "path": "%LOCALAPPDATA%\\Mozilla\\Firefox", "mode": "folder", "notInstalled": ["Firefox"] },
        { "path": "%APPDATA%\\Opera Software", "mode": "folder", "notInstalled": ["Opera"] },
        { "path": "%LOCALAPPDATA%\\Opera Software", "mode": "folder", "notInstalled": ["Opera"] },
        { "path": "%APPDATA%\\Moises", "mode": "folder", "notInstalled": ["Moises"] },
        { "path": "%LOCALAPPDATA%\\warp", "mode": "folder", "notInstalled": ["Warp"] },
        { "path": "%USERPROFILE%\\.warp", "mode": "folder", "notInstalled": ["Warp"] }
      ]
    }
  ]
}
